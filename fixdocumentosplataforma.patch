 apps/api/documentos/generador.py                      |  2 +-
 apps/api/documentos/mtd.py                            |  7 +++++--
 apps/api/documentos/pdf.py                            |  6 +++++-
 apps/api/documentos/schemas.py                        |  4 +++-
