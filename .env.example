# ============================================================
# PermitFlow ES - environment variables
# Copy the frontend block to apps/web/.env.local.
# Copy the backend block to apps/api/.env.
# Never commit real secrets.
# ============================================================

# --- FRONTEND (apps/web/.env.local) -------------------------

# Clerk auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# URLs
NEXT_PUBLIC_URL=http://localhost:3007
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...

# Google Maps Places autocomplete
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Variables de servidor (No exponer a NEXT_PUBLIC)
INTERNAL_API_KEY=                     # Clave compartida con FastAPI para endpoints internos
DEEPSEEK_API_KEY=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com


# --- BACKEND (apps/api/.env) --------------------------------

# Database - Supabase PostgreSQL
#
# Rol 'postgres' = superusuario: SIEMPRE ignora Row Level Security (RLS),
# tenga o no FORCE ROW LEVEL SECURITY. Es el valor por defecto de Supabase y
# el que usa hoy este proyecto.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
#
# Para activar de verdad las políticas RLS de
# supabase/migrations/20260806120000_rls_aislamiento_multi_tenant.sql
# (B-05 de la auditoría 2026-08-06), cambia a este formato usando el rol
# 'app_backend' (sin BYPASSRLS) que crea esa misma migración:
#   1. Ejecuta `python apps/api/scripts/rotar_rol_app_backend.py` para
#      generar una contraseña nueva y ver el comando ALTER ROLE exacto
#      (el script NO escribe la contraseña en ningún fichero del repo).
#   2. Ejecuta ese ALTER ROLE en el SQL Editor de Supabase.
#   3. Sustituye DATABASE_URL aquí y en Railway/donde despliegues por:
#      postgresql://app_backend:[PASSWORD_GENERADA]@db.[PROJECT].supabase.co:5432/postgres
# apps/api/servicios/tenant_context.py ya fija app.current_org_id en cada
# request del asistente; sin este cambio de rol, ese GUC se fija pero
# Postgres lo ignora (comportamiento actual, sin romper nada).

# Redis cache
REDIS_URL=redis://localhost:6379

# AI provider
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Google Geocoding API
GOOGLE_MAPS_API_KEY=

# Clerk token verification
CLERK_SECRET_KEY=sk_test_...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend
RESEND_API_KEY=re_...
NOTIFICATION_EMAIL=tu@email.com
RESEND_FROM_DOMAIN=tu-dominio.com

# Supabase service integrations
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Monitoring
SENTRY_DSN=https://...@sentry.io/...

# Seguridad interna: clave compartida con Next.js (cabecera X-Internal-Key).
# OBLIGATORIA en producción (ver seguridad.py) — sin ella, y sin ENVIRONMENT=production,
# el gate de autenticación interna queda abierto.
INTERNAL_API_KEY=

# Clave secreta para HMAC de tokens de estudio y hash del CUPS.
# OBLIGATORIA: la app falla al arrancar si falta (sin valor por defecto).
# Generar: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Orígenes permitidos para CORS, separados por comas. NUNCA usar "*" en producción.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# IPs de proxies de confianza (balanceador), separadas por comas. Si se deja vacío,
# el rate limiting del simulador público operará sobre la IP del balanceador,
# compartiendo cuota entre todos los usuarios. Ver nota en main.py.
TRUSTED_PROXIES=

# Runtime — usar "production" en despliegues reales (ver B-03 en auditoría:
# con el default "development" el gate INTERNAL_API_KEY puede quedar abierto).
ENVIRONMENT=development
