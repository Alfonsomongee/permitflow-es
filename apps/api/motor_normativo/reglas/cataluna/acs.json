  "reglas": [
    {
      "id": "CAT-ACS-RITE-EXENTA-EQUIPO",
      "descripcion": "ACS por calentador instantáneo, calentador acumulador o termo eléctrico hasta 70 kW, o sistema solar de un único elemento prefabricado: exenta de documentación técnica y de registro (RD 1027/2007, arts. 15.1.c y 24.2).",
      "condicion": {
        "and": [
          {
            "or": [
              {
                "and": [
                  {
                    "in": [
                      {
                        "var": "tipo_generador_acs"
                      },
                      [
                        "calentador_instantaneo",
                        "calentador_acumulador",
                        "termo_electrico"
                      ]
                    ]
                  },
                  {
                    "<=": [
                      {
                        "var": "potencia_kw"
                      },
                      70
                    ]
                  }
                ]
              },
              {
                "==": [
                  {
                    "var": "tipo_generador_acs"
                  },
                  "sistema_solar_prefabricado"
                ]
              }
            ]
          },
          {
            ">=": [
              {
                "var": "potencia_kw"
              },
              5
            ]
          }
        ]
      },
      "tramites": [
        {
          "orden": 1,
          "nombre": "Sin trámite ante la Administración: instalación exenta por tipo de equipo",
          "organismo": "Instalador habilitado",
          "base_legal": "RD 1027/2007 (RITE), arts. 15.1.c y 24.2",
          "tipo_actuacion": "informativa",
          "plazo_estimado_dias": null,
          "plazo_legal_dias": null,
          "plataforma": null,
          "plataforma_url": null,
          "coste_estimado": "Sin coste administrativo",
          "formulario_ref": null,
          "registro_salida": null,
          "medio_presentacion": null,
          "documentos_requeridos": [],
          "paralelo_con": null,
          "notas": "El RITE excluye expresamente de presentar documentación y de acreditar el cumplimiento ante la comunidad autónoma a las instalaciones de agua caliente sanitaria producidas con calentadores instantáneos, calentadores acumuladores o termos eléctricos hasta 70 kW (sumando todos los equipos), y a los sistemas solares de un único elemento prefabricado. No hay memoria técnica ni registro que presentar. La instalación debe ejecutarla igualmente una empresa instaladora habilitada y cumplir el resto de exigencias técnicas; si además hay obligaciones sanitarias (legionelosis), esas siguen aplicando aparte."
        }
      ]
    },
