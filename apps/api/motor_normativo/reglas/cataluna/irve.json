      "condicion": {
        "not": {
          "or": [
            { "==": [{ "var": "modo_recarga" }, 4] },
            {
              "and": [
                { "==": [{ "var": "ubicacion_irve" }, "interior"] },
                { ">": [{ "var": "potencia_kw" }, 50] }
              ]
            },
            {
              "and": [
