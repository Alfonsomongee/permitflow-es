            {
              "id": "certificado_instalacion_termica",
              "label": "Certificado de Instalación Térmica",
              "descripcion": "Certificado firmado por instalador.",
              "obligatorio": true
            }
          ],
          "notas": "Instalaciones de 5 kW a 70 kW requieren MTD.",
          "paralelo_con": null
