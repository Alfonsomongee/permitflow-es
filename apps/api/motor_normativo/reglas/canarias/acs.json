          "paralelo_con": null
        }
      ]
    },
    {
      "id": "CAN-ACS-003",
      "descripcion": "Mantenimiento del Plan de Prevención (Legionela)",
      "condicion": {
        "and": [
          { ">": [{ "var": "potencia_kw" }, 70] },
          { "!=": [{ "var": "uso" }, "residencial"] }
        ]
      },
      "tramites": [
        {
          "orden": 4,
          "nombre": "Mantenimiento del Plan de Prevención (PPCL o PSL)",
          "organismo": "Titular de la instalación",
          "base_legal": "RD 487/2022 (estatal)",
          "plazo_estimado_dias": 1,
          "plazo_legal_dias": null,
          "plataforma": null,
          "plataforma_url": null,
          "coste_estimado": "Coste de elaboración del plan",
          "documentos_requeridos": [
            {
              "id": "plan_prevencion_legionela",
              "label": "PPCL o PSL",
              "descripcion": "Plan de Prevención y Control de Legionella in situ.",
              "obligatorio": true
            }
          ],
          "notas": "En Canarias no se registran administrativamente los sistemas ACS, solo se mantiene el plan in situ. (El trámite SICAC 5753 es solo para torres de refrigeración y condensadores evaporativos).",
          "paralelo_con": null
        }
      ]
    }
